
<div class="container-xxl h-100 w-100 justify-content-center">
    <div class="d-flex flex-column main-content">
        <div class="d-flex flex-column m-3">
            <h1 class="description">
                @Description
            </h1>
        </div>
        <div class="d-flex justify-content-between align-items-center w-100 h-100 flex-grow-1 img-content">
            <div class="d-flex justify-content-center align-items-center flex-grow-1 rounded-pill">
                @Right
            </div>
            <div class="d-flex justify-content-center align-items-center flex-grow-1 rounded-pill">
                @Left
            </div>
        </div>
    </div>
</div>


@code {

    [Parameter, EditorRequired]
    public EventCallback RightHandSideNav { get; set; }

    [Parameter, EditorRequired]
    public EventCallback LeftHandSideNav { get; set; }

    [Parameter]
    public string Description { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Right { get; set; }

    [Parameter, EditorRequired]
    public RenderFragment Left { get; set; }
}
