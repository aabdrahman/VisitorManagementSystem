@inherits LayoutComponentBase


<div class="bb-page-sidebar">

    <Sidebar @ref="sidebar"
             IconName="IconName.Person"
             Title=@Greeting
             Width="15"
             WidthUnit="Unit.Vw"
             DataProvider="SidebarDataProvider" />

    <main>
        <div class="bb-top-row px-4 d-flex justify-content-between">
            <Icon Name="IconName.List" role="button" @onclick="ToggleSidebar" />
            <a href="https://docs.microsoft.com/aspnet/" role="button" target="_blank">About</a>
        </div>

        <article class="content px-4">
            <div class="py-2">@Body</div>
        </article>
    </main>

</div>

