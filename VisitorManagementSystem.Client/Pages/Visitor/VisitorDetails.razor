                <p class="card-text fw-bold">@Visitor.PhoneNumber</p>
            </div>
            <div class="d-flex flex-row justify-content-between">
                <label class="card-text fw-bolder">Visitor Email Address: </label>
                <p class="card-text fw-bold">@(Visitor?.EmailAddress ?? "")</p>
            </div>
        </div>
    </div>
</div>
*@
<div class="container py-4">
    <div class="card shadow-lg border-0 rounded-4">
        <div class="card-header bg-success text-white text-center fw-bold rounded-top-4">
            Visitor Details — @Visitor.VisitorName
        </div>
        <div class="card-body px-5 py-4">
            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="fw-semibold text-muted">Visitor Name:</label>
                </div>
                <div class="col-md-8 text-end">
                    <span class="fw-bold fs-5">@Visitor.VisitorName</span>
                </div>
            </div>
            <div class="row mb-3 border-top pt-3">
                <div class="col-md-4">
                    <label class="fw-semibold text-muted">Phone Number:</label>
                </div>
                <div class="col-md-8 text-end">
                    <span class="fw-bold">@Visitor.PhoneNumber</span>
                </div>
            </div>
            <div class="row mb-3 border-top pt-3">
                <div class="col-md-4">
                    <label class="fw-semibold text-muted">Email Address:</label>
                </div>
                <div class="col-md-8 text-end">
                    <span class="fw-bold">@(Visitor?.EmailAddress ?? "-")</span>
                </div>
            </div>
            <div class="row mb-3 border-top pt-3">
                <div class="col-md-4">
                    <label class="fw-semibold text-muted">Gender:</label>
                </div>
                <div class="col-md-8 text-end">
                    <span class="fw-bold">@(Visitor.Gender)</span>
                </div>
            </div>
            <div class="row border-top pt-3">
                <div class="col-md-4">
                    <label class="fw-semibold text-muted">Status:</label>
                </div>
                <div class="col-md-8 text-end">
                    @if (Visitor.IsActive == "active")
                    {
                        <span class="badge bg-success rounded-pill px-3 py-2">Active</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary rounded-pill px-3 py-2">Inactive</span>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter, EditorRequired]
    public VisitorDto Visitor { get; set; }
}
