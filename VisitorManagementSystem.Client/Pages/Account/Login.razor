@page "/identity/login"
@layout EmptyLayout
@inject AuthenticationSigninHandler authenticationSigninHandler

<PageTitle>Login Page</PageTitle>

<div class="login-wrap">
	
	<div class="login-html">
		<input id="tab-1" type="radio" name="tab" class="sign-in" checked><label for="tab-1" class="tab">Sign In</label>
		
		<input id="tab-2" type="radio" name="tab" class="sign-up"><label for="tab-2" class="tab"></label>
		
		<div class="login-form mt-2">
			<div class="sign-in-htm">
				<div class="group">
					<label for="user" class="label">Username</label>
					<input id="user" type="text" class="input" @bind-value="_userToLogin.UserName" @bind-value:event="oninput">
				</div>
				<div class="group">
					<label for="pass" class="label">Password</label>
					<input id="pass" type="password" class="input" data-type="password" @bind-value="_userToLogin.Password" @bind-value:event="oninput">
				</div>
				
				@if(!_isSuccessful && _errorMessage is not null)
				{
					<div class="d-flex justify-content-center align-items-center m-2">
						<span class="text-danger text-center" role="alert">@_errorMessage</span>
					</div>
				}
				
				<div class="group">
					@if(_isLoading)
					{
						<button class="button" type="button" disabled>
							<span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
							<span role="status">Loading...</span>
						</button>
					}
					else
					{
						<input type="submit" class="button" @onclick="HandleLogin" value="Sign In">
					}
				</div>
				<div class="hr"></div>
				<div class="foot-lnk">
					<a href="#forgot">Forgot Password?</a>
				</div>
			</div>
			@*
			<div class="sign-up-htm">
				<div class="group">
					<label for="user" class="label">Username</label>
					<input id="user" type="text" class="input">
				</div>
				<div class="group">
					<label for="pass" class="label">Password</label>
					<input id="pass" type="password" class="input" data-type="password">
				</div>
				<div class="group">
					<label for="pass" class="label">Repeat Password</label>
					<input id="pass" type="password" class="input" data-type="password">
				</div>
				<div class="group">
					<label for="pass" class="label">Email Address</label>
					<input id="pass" type="text" class="input">
				</div>
				<div class="group">
					<input type="submit" class="button" value="Sign Up">
				</div>
				<div class="hr"></div>
				<div class="foot-lnk">
					 <label for="tab-1"><a>Already Member?</a></label>
				</div>
			</div>
			*@
		</div>
	</div>
</div>

@code {
	private UserToLoginDto _userToLogin;
	private bool _isLoading = false;
	private string _errorMessage;
	private bool _isSuccessful;

	protected override Task OnInitializedAsync()
	{
		_userToLogin = new();
		return base.OnInitializedAsync();
	}

	private async Task HandleLogin()
	{
		_isLoading = true;_errorMessage = null;
		//await Task.Delay(5000);
		var loginResponse = await authenticationSigninHandler.Handle(_userToLogin);

		_isLoading = false;_isSuccessful = loginResponse.Item1;
		_errorMessage = loginResponse.Item2;

		if(_isSuccessful)
		{
			navManager.NavigateTo("/");
		}
	}
}
