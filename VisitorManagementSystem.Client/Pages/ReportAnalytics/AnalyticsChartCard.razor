@inject IJSRuntime JSRuntime

<div class="card draggable shadow-sm mt-3">
    <div class="card-header bg-transparent">
        <h6 class="text-uppercase text-muted ls-1 mb-1">@(string.IsNullOrEmpty(Title) ? "Bar Chart" : $"{Title}")</h6>
        <h5 class="h3 mb-0">@(string.IsNullOrEmpty(SubTitle) ? "Chart Records" : $"{SubTitle}")</h5>
    </div>
    <div class="card-body">
        <div class="chart" style="height: 300px;width:900px;">
            <canvas id="@CanvasId" class="chart-bar chart-canvas w-100"></canvas>
        </div>
    </div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "";
    [Parameter]
    public string SubTitle { get; set; } = "";
    public string CanvasId { get; set; } = $"chart-{Guid.NewGuid()}";
    [Parameter, EditorRequired]
    public int[] Data { get; set; }
    [Parameter, EditorRequired]
    public string[] Labels { get; set; }
    [Parameter]
    public bool IsHorizontal { get; set; } = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if(firstRender)
        {
            await JSRuntime.InvokeVoidAsync("initializeBarChart", this.CanvasId, this.Labels, this.Data, string.IsNullOrEmpty(Title) ? "Bar Chart" : $"{Title}", IsHorizontal);
        }
    }
}
