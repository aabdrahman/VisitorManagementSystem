@page "/manage-visits"
@using System.ComponentModel
@attribute [Authorize(Roles = "Admin, Receptionist")]

@*
<SearchFilter SpoolRequest="HandleSpool" />
*@

<div class="container-fluid">
    <div class="row">
        <div class="d-flex flex-column justify-content-start align-items-center my-2 gap-2 col-lg-2">
            <label for="startdate" class="fw-bold text-start fst-normal mb-1">Start Date:</label>
            <input type="date" name="startdate" class="form-control" placeholder="" @bind-value="_visitDetailRequestParameter.startDate" @bind-value:event="oninput" />
        </div>
        <div class="d-flex flex-column justify-content-start align-items-center my-2 gap-2 col-lg-2">
            <label for="enddate" class="fw-bold text-start fst-normal mb-1">End Date:</label>
            <input type="date" name="enddate" class="form-control" placeholder="" @bind-value="_visitDetailRequestParameter.endDate" @bind-value:event="oninput" />
        </div>
        <div class="d-flex flex-column justify-content-start align-items-center gap-2 my-2 col-lg-2">
            <label for="pagesize" class="fw-bold text-start fst-normal mb-1">Page Size:</label>
            <input type="number" name="pagesize" min="1" max="50" class="form-control" placeholder="" @bind-value="_visitDetailRequestParameter.PageSize" @bind-value:event="oninput" />
        </div>
        <div class="d-flex flex-column justify-content-start align-items-center gap-2 my-2 col-lg-2">
            <label for="pagenumber" class="fw-bold text-start fst-normal mb-1">Page Number:</label>
            <input type="number" name="pagenumber" min="1" class="form-control" placeholder="" @bind-value="_visitDetailRequestParameter.pageNumber" @bind-value:event="oninput" />
        </div>
        <div class="d-flex flex-column justify-content-start align-items-center gap-2 my-2 col-lg-2">
            <label for="startdate" class="fw-bold text-start fst-normal mb-1">Visit Status:</label>
            <select name="status" class="form-select" @bind-value="_visitDetailRequestParameter.Status" @bind-value:event="oninput">
                <option value=""></option>
                @foreach (var item in Enum.GetValues(typeof(VisitStatus)))
                {
                    <option value="@item.ToString()">@item.ToString()</option>
                }
            </select>
        </div>
        <div class="col-lg-2 d-flex justify-content-center align-items-center">
            <button class="btn btn-primary" @onclick="HandleSpool">
                Spool
            </button>
        </div>
    </div>
</div>

@if (_isLoading)
{
    <div class="d-flex justify-content-center my-4 w-100 h-100">
        <div class="spinner-border" style="width: 3rem; height: 3rem;" role="status">
            <span class="visually-hidden">Loading...</span>
        </div>
    </div>
}

@if (_visits.Count() > 0)
{
    <div class="d-flex justify-content-center align-items-center py-2">
        <table class="table table-striped table-hover mt-3">
            <thead>
                <tr>
                    @foreach (var item in typeof(VisitDetailDto).GetMembers().Where(x => x.MemberType == System.Reflection.MemberTypes.Property).Select(x => x.Name))
                    {
                        <th scope="col">@item</th>
                    }
                    <th scope="col">Operations</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var visit in _visits)
                {
                    <tr>
                        @foreach (var member in typeof(VisitDetailDto).GetMembers().Where(x => x.MemberType == System.Reflection.MemberTypes.Property))
                        {

                            <td @onclick="(() => ManageClick(visit))" class="text-center text-wrap fs-6 fst-italic">@visit.GetType().GetProperty(member.Name)?.GetValue(visit)</td>
                        }
                        <td>
                            <div class="d-flex justify-content-evenly align-items-center">
                                @if(visit.VisitStatus == VisitStatus.Pending.ToString() || visit.VisitStatus == VisitStatus.Scheduled.ToString())
                                {
                                    <button class="btn btn-outline-secondary" title="CheckIn" @onclick="(() => ManageCheckInClick(visit))">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-box-arrow-in-right" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M6 3.5a.5.5 0 0 1 .5-.5h8a.5.5 0 0 1 .5.5v9a.5.5 0 0 1-.5.5h-8a.5.5 0 0 1-.5-.5v-2a.5.5 0 0 0-1 0v2A1.5 1.5 0 0 0 6.5 14h8a1.5 1.5 0 0 0 1.5-1.5v-9A1.5 1.5 0 0 0 14.5 2h-8A1.5 1.5 0 0 0 5 3.5v2a.5.5 0 0 0 1 0z" />
                                            <path fill-rule="evenodd" d="M11.854 8.354a.5.5 0 0 0 0-.708l-3-3a.5.5 0 1 0-.708.708L10.293 7.5H1.5a.5.5 0 0 0 0 1h8.793l-2.147 2.146a.5.5 0 0 0 .708.708z" />
                                        </svg>
                                    </button>
                                }
                                @if(visit.VisitStatus == VisitStatus.CheckedIn.ToString())
                                {
                                    <button class="btn btn-outline-secondary" title="CheckOut" @onclick="(() => ManageCheckOutClick(visit))">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" fill="currentColor" class="bi bi-box-arrow-left" viewBox="0 0 16 16">
                                            <path fill-rule="evenodd" d="M6 12.5a.5.5 0 0 0 .5.5h8a.5.5 0 0 0 .5-.5v-9a.5.5 0 0 0-.5-.5h-8a.5.5 0 0 0-.5.5v2a.5.5 0 0 1-1 0v-2A1.5 1.5 0 0 1 6.5 2h8A1.5 1.5 0 0 1 16 3.5v9a1.5 1.5 0 0 1-1.5 1.5h-8A1.5 1.5 0 0 1 5 12.5v-2a.5.5 0 0 1 1 0z" />
                                            <path fill-rule="evenodd" d="M.146 8.354a.5.5 0 0 1 0-.708l3-3a.5.5 0 1 1 .708.708L1.707 7.5H10.5a.5.5 0 0 1 0 1H1.707l2.147 2.146a.5.5 0 0 1-.708.708z" />
                                        </svg>
                                    </button>
                                }
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
    @if(_metaData is not null)
    {
        <div class="d-flex align-items-center justify-content-center mt-1 gap-3">
            <button class="btn btn-primary rounded-pill" disabled="@(!_metaData.hasPrevious)" role="button" type="button" @onclick="PrevPage">
                <i class="bi bi-arrow-left"></i>
            </button>

            <span>Page @_metaData.currentPage of @_metaData.totalPages</span>
            @*
            <span>
            <input class="form-control" type="number" @bind:event="oninput" @bind="CurrentPage" @onkeydown="OnChangePageNum" />
            </span>
            *@
            <button class="btn btn-primary rounded-pill" disabled="@(!_metaData.hasNext)" @onclick="NextPage">
                <i class="bi bi-arrow-right"></i>
            </button>
        </div>
    }
}

<Popup @ref="popup" ShowCloseButton="_showCloseButton" Title="@Title">
    <Body>
        <VisitOperation Visit="_selectedVisit" ReadOnly="OperationType" HandleClose="@(() => 
        {
            popup.Close();
            HandleSpool();
            StateHasChanged();
        })" />
    </Body>
</Popup>


@code {
    private bool _isLoading = false;
    private bool _isSuccessful;
    private IEnumerable<VisitDetailDto> _visits = [];
    private MetaData? _metaData;
    private VisitDetailRequestParameter _visitDetailRequestParameter;
    private VisitDetailDto _selectedVisit = new();
    private Popup popup;
    private bool OperationType = false;
    private bool _showCloseButton = false;
    private string Title = "Visitor Check In";

    protected override Task OnInitializedAsync()
    {
        _visitDetailRequestParameter = new() { pageNumber = 1, PageSize = 10 };
        return base.OnInitializedAsync();
    }

    private void ManageClick(VisitDetailDto selectedVisit)
    {
        OperationType = true; Title = "Visit Details";
        _selectedVisit = selectedVisit; _showCloseButton = true;
        popup.Open();
    }

    private async Task HandleSpool()
    {
        _isLoading = true;
        var response = await getVisitsHandler.Handle(_visitDetailRequestParameter);
        _visits = response.Item1;_metaData = response.Item2;
        _isSuccessful = _visits.Count() > 0;
        _isLoading = false;
        StateHasChanged();
    }

    private void ManageCheckInClick(VisitDetailDto visitToCheckin)
    {
        Title = "Visitor Check In";OperationType = false;
        _selectedVisit = visitToCheckin;
        _showCloseButton = false;
        popup.Open();
    }

    private void ManageCheckOutClick(VisitDetailDto visitToCheckout)
    {
        Title = "Visitor Check Out"; OperationType = false;
        _showCloseButton = false;
        _selectedVisit = visitToCheckout;
        popup.Open();
    }

    private async Task PrevPage()
    {
        var currPage = _visitDetailRequestParameter.pageNumber;
        _visitDetailRequestParameter.pageNumber = currPage - 1;
        await HandleSpool();

    }

    private async Task NextPage()
    {
        var currPage = _visitDetailRequestParameter.pageNumber;
        _visitDetailRequestParameter.pageNumber = currPage + 1;
        await HandleSpool();
    }
}
