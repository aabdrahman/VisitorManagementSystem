@code {
    private EditContext _editContext;
    private ScheduleVisitDetailDto _scheduleVisitDetail;
    private string _loggedinUser;
    private bool _isRecurring;
    private string _getVisitorResponse;
    private bool _isLoading;
    private string _scheduleVisitResponse;
    private bool _scheduleVisitSuccessStatus;
    private OperationType _operationType = default;
    private IEnumerable<VisitDetailDto> _visits = [];
    private MetaData _metaData;

    protected override async Task OnInitializedAsync()
    {
        var user = (await authStateProvider.GetAuthenticationStateAsync()).User;
        _loggedinUser = user.FindFirst(x => x.Type.EndsWith("claims/name"))?.Value ?? "anonymous";
        _scheduleVisitDetail = new();
        _scheduleVisitDetail.HostName = _loggedinUser.Replace(".", " ");
        _scheduleVisitDetail.VisitType = VisitType.Appointment.ToString();
        _scheduleVisitDetail.VisitationDate = DateOnly.FromDateTime(DateTime.Now.AddDays(1));
        await Task.Delay(500);
        _editContext = new EditContext(_scheduleVisitDetail);
    }

    private async Task OnHandleSubmit()
    {
        _isLoading = true;
        var response = await scheduleVisitHandler.Handle(_scheduleVisitDetail);
        _scheduleVisitResponse = response.Item2; _scheduleVisitSuccessStatus = response.Item1;
        _isLoading = false;
        if(_scheduleVisitSuccessStatus)
        {
            await ResetForm();
        }
    }

    private async Task ResetForm()
    {
        var user = (await authStateProvider.GetAuthenticationStateAsync()).User;
        _loggedinUser = user.FindFirst(x => x.Type.EndsWith("claims/name"))?.Value ?? "anonymous";
        _scheduleVisitDetail = new();
        _scheduleVisitDetail.HostName = _loggedinUser.Replace(".", " ");
        _scheduleVisitDetail.VisitType = VisitType.Appointment.ToString();
        _scheduleVisitDetail.VisitationDate = DateOnly.FromDateTime(DateTime.Now.AddDays(1));
        _editContext = new EditContext(_scheduleVisitDetail);
        // _getVisitorResponse = default; _scheduleVisitResponse = default;
        // _scheduleVisitSuccessStatus = default;
    }

    private async Task GetVisitorDetailsByPhoneNumber(KeyboardEventArgs args)
    {
        if(args.Key == "Enter" && _scheduleVisitDetail.VisitorRegistrationType == VisitorRegistrationTypes.Recurring.ToString())
        {
            await Task.Delay(500);
            var response = await getVisitorByPhoneNumberHandler.Handle(_scheduleVisitDetail.VisitorPhoneNumber);
            if(response is null)
            {
                _getVisitorResponse = "An Error Occurred";
                return;
            }

            if(response?.ResponseCode != "00")
            {
                _getVisitorResponse = response.ResponseMessage;
                return;
            }

            var visitor = JsonSerializer.Deserialize<VisitorDto>(JsonSerializer.Serialize(response.ResponseData), new JsonSerializerOptions() { PropertyNameCaseInsensitive = true });

            _scheduleVisitDetail.VisitorName = visitor.VisitorName;
            _scheduleVisitDetail.VisitorEmailAddress = visitor.EmailAddress;
            _scheduleVisitDetail.VisitorPhoneNumber = visitor.PhoneNumber;
            _scheduleVisitDetail.VisitorGender = visitor.Gender;
            _editContext = new EditContext(_scheduleVisitDetail);
            StateHasChanged();
        }
    }

    private void ManageRegistrationTypeChange()
    {
        if(_scheduleVisitDetail.VisitorRegistrationType == VisitorRegistrationTypes.Recurring.ToString())
        {
            _isRecurring = true;
        }
        else
        {
            _isRecurring = false;
        }
    }

}

