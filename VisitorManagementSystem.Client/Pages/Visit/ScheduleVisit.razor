@page "/schedule-visit"
@using System.Text.Json
@attribute [Authorize(Roles = "Admin, User, Receptionist")]

<PageTitle>Schedule Visit</PageTitle>

<h3 class="display-3">Schedule Visit</h3>
@*
<div class="d-flex w-100 justify-content-between align-items-center my-3 mx-4 px-4">
    <button class="btn btn-primary text-center" role="button" @onclick="(() => _operationType = OperationType.ScheduleNewVisit)">Schedule New Visit</button>
    <button class="btn btn-primary text-center" role="button" @onclick="(() => _operationType = OperationType.SpoolScheduledVisit)">Spool Scheduled Visit</button>
</div>
