@page "/scheduled-visit"
@inject NavigationManager navManager
@inject GetByIdentificationNumberHandler getByIdentificationNumberHandler
@inject ScheduledVisitCheckinHandler scheduledVisitCheckinHandler

<PageNav Description="Enter your Visitor Identification Number" GoToPreviousPage="HandleGoToPreviousPage">
    <ContentBody>
        <div class="d-flex flex-column justify-content-center align-items-center w-100">
            <div class="form-group d-block w-100 mb-2">
                <InputText @bind-Value="_visitorIdentificationNumber" class="form-control w-100" />
                <span class="text-danger" role="alert">@_errorMessage</span>
            </div>
            @if(_isLoading)
            {
                <button class="btn btn-primary" type="button" disabled>
                    <span class="spinner-border spinner-border-sm" aria-hidden="true"></span>
                    <span role="status">Loading...</span>
                </button>
            }
            else
            {
           
                <div class="d-flex justify-content-between w-100">
                    <button class="btn btn-secondary" type="button" role="button" @onclick="ResetForm">Clear</button>
                    <button class="btn btn-primary" type="submit" role="button" @onclick="GetDetails">Submit</button>
                </div>
            }
        </div>
    </ContentBody>
</PageNav>

<Popup @ref="popup" Title="Visitor Self Check In" ShowFooter="false" SaveChanges="HandleSaveChnages">
    <Body>
        <VisitDetail visitDetail="_visitDetail" CheckIn="HandleCheckIn" ErrorMessage="_isCheckInError" isSuccessful="isCheckedIn" />
    </Body>
</Popup>

@code {
    private string _visitorIdentificationNumber;
    private string _errorMessage;
    private bool _isLoading = false;
    private string _message;
    private Popup popup;
    private VisitDetailDto _visitDetail = new();

    private bool isCheckedIn;
    private string _isCheckInError = "";

    private void HandleGoToPreviousPage()
    {
        navManager.NavigateTo("/");
    }

    private async Task GetDetails()
    {
        if(string.IsNullOrEmpty(_visitorIdentificationNumber))
        {
            _errorMessage = "Invalid Input. Kindly provide Visitor Identification Number";
        }
        else
        {
            _isLoading = true; _errorMessage = null;
            await HandleGetDetails();
            _isLoading = false;

        }
    }

    private async Task HandleCheckIn()
    {
        var request = new UpdateVisitStatusDto() { UpdatedStatus = VisitStatus.Pending, VisitorIdentificationNumber = _visitDetail.VisitorIdentificationNumber };
        var response = await scheduledVisitCheckinHandler.Handle(request);
        if(response.ResponseCode == "00")
        {
            popup.Close();
            navManager.NavigateTo("/");
        }
        else
        {
            _isCheckInError = response.ResponseMessage;
            isCheckedIn = false;
            StateHasChanged();
        }
    }

    private async Task HandleGetDetails()
    {
        var getDetailsResponse = await getByIdentificationNumberHandler.Handle(_visitorIdentificationNumber);

        if(getDetailsResponse.visitDetail is null)
        {
            _errorMessage = getDetailsResponse.respMsg;
        }
        else
        {
            _visitDetail = getDetailsResponse.visitDetail;
            popup.Open();
        }

    }

    private void ResetForm()
    {
        _visitorIdentificationNumber = null;
        _errorMessage = null;
        _isLoading = false;
        _visitDetail = new();
    }

    private void HandleSaveChnages()
    {
        navManager.NavigateTo("/");
    }
}
