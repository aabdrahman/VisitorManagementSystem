@page "/visitor-type"
@inject NavigationManager navManager

<PageNav Description="Are you part of a group?" GoToPreviousPage="HandleGoToPreviousPage">
    <ContentBody>
        <div class="d-flex w-100 h-100 justify-content-between align-items-center g-3">
            <img src="/Images/Yes.png" alt='Yes clip art' width="250" height="250" role="button" @onclick="HandleRightClicked" />
            <img src="/Images/No.png" alt='Yes clip art' width="250" height="250" role="button" @onclick="HandleLeftClicked" />
        </div>
    </ContentBody>
</PageNav>

<Popup @ref="popup" Title="Upcoming functionality" ShowFooter="false" ShowCloseButton="true">
    <Body>
        <div class="d-flex justify-content-center align-items-center flex-column w-100 h-100">
            <h6 class="w-100 text-center">Upcoming Feature</h6>
            <p class="fst-italic text-info fw-bold text-wrap text-center">
                The group visit functionality is not implemented yet.
            </p>
        </div>
    </Body>
</Popup>


@code {
    private Popup popup;

    private void HandleRightClicked()
    {
        popup.Open();
    }

    private void HandleLeftClicked()
    {
        navManager.NavigateTo("new-visitor-booking");
    }

    private void HandleGoToPreviousPage()
    {
        navManager.NavigateTo("confirm-already-visit");
    }
}
