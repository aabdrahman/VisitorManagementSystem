
<div class="card shadow-lg border-0">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h4 class="mb-0">Visit Details</h4>
        <span class="badge bg-dark fs-6">@visitDetail.VisitorIdentificationNumber</span>
    </div>
   @if(!isSuccessful)
    {
        <div class="d-flex">
            <span class="text-danger" role="alert">@Message</span>
        </div>
    }
    <div class="card-body">
        <dl class="row mb-0">
            <dt class="col-sm-4">Visitor Name:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.VisitorName</dd>

            <dt class="col-sm-4">Phone Number:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.VisitorPhoneNumber</dd>

            <dt class="col-sm-4">Email Address:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.VisitorEmailAddress</dd>

            <dt class="col-sm-4">Gender:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.VisitorGender</dd>

            <dt class="col-sm-4">Host Name:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.HostName</dd>

            <dt class="col-sm-4">Purpose of Visit:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.PurposeOfVisit</dd>

            <dt class="col-sm-4">Visitation Date:</dt>
            <dd class="col-sm-8 fw-bold">@visitDetail.VisitDate.ToString("D")</dd>
        </dl>
    </div>

    <div class="card-footer d-flex justify-content-end">
        <button class="btn btn-primary px-4" @onclick="HandleCheckIn">
            Proceed to Check-in
        </button>
    </div>
</div>



@code {

    [Parameter, EditorRequired]
    public VisitDetailDto visitDetail { get; set; }

    [Parameter, EditorRequired]
    public EventCallback CheckIn { get; set; }

    [Parameter]
    public string Message { get; set; } = string.Empty;
    [Parameter]
    public string ErrorMessage { get; set; } = string.Empty;
    [Parameter]
    public bool isSuccessful { get; set; }

    protected override void OnParametersSet()
    {
        if(visitDetail is not null)
        {
            base.OnParametersSet();
        }
    }

    private async Task HandleCheckIn()
    {
        await CheckIn.InvokeAsync();
    }
}
